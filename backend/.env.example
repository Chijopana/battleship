# Puerto de escucha (Render lo inyecta automáticamente)
PORT=3001

NODE_ENV=production

# Dominios extra permitidos por CORS, separados por comas.
# localhost y el dominio de Netlify ya vienen en la lista por defecto.
# ALLOWED_ORIGINS=https://tu-sitio.netlify.app,https://tu-dominio.com

# Tope de eventos de disparo por segundo y jugador (protección anti-flood).
# MAX_SHOTS_PER_SECOND=8
